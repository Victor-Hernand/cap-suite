---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BackLink from '../../../components/admin/BackLink.astro';
import CollectionManager from '../../../components/admin/CollectionManager.vue';
import type { Collection, Column, Field, Row } from '../../../components/admin/types';
import { noticeKinds } from '../../../data/departments';
import { labelOf } from '../../../data/policies';
import { FIELD_MAX } from '../../../lib/fieldRules';
import { getDb } from '../../../lib/db';
import { cardClass, inlineLinkClass } from '../../../lib/capClasses';
import { formats, links, notices, processes, splitSteps } from '../../../lib/departmentContent';
import { getDepartmentBySlug } from '../../../lib/departments';

const db = getDb();
const department = getDepartmentBySlug(db, Astro.params.slug ?? '');
if (!department) return Astro.redirect('/admin/departamentos');

interface Section {
  title: string;
  collection: Collection;
  entityName: string;
  entityNamePlural: string;
  entityGender: 'm' | 'f';
  rows: Row[];
  columns: Column[];
  fields: Field[];
}

const sections: Section[] = [
  {
    title: 'Procesos',
    collection: 'departmentProcesses',
    entityName: 'proceso',
    entityNamePlural: 'procesos',
    entityGender: 'm',
    rows: processes.list(db, department.name).map((process) => ({
      ...process,
      stepsSummary: splitSteps(process.steps).join(' → '),
    })),
    columns: [
      { key: 'name', label: 'Nombre' },
      { key: 'stepsSummary', label: 'Pasos', kind: 'muted' },
    ],
    fields: [
      { name: 'name', label: 'Nombre', kind: 'text', required: true, maxLength: FIELD_MAX.name },
      {
        name: 'steps',
        label: 'Pasos',
        kind: 'textarea',
        required: true,
        hint: 'Un paso por línea.',
        maxLength: FIELD_MAX.longText,
      },
    ],
  },
  {
    title: 'Formatos',
    collection: 'departmentFormats',
    entityName: 'formato',
    entityNamePlural: 'formatos',
    entityGender: 'm',
    rows: formats.list(db, department.name).map((format) => ({
      ...format,
      source: format.url ?? `Archivo: ${format.filePath}`,
    })),
    columns: [
      { key: 'name', label: 'Nombre' },
      { key: 'source', label: 'Origen', kind: 'muted' },
    ],
    fields: [
      { name: 'name', label: 'Nombre', kind: 'text', required: true, maxLength: FIELD_MAX.name },
      {
        name: 'url',
        label: 'Enlace',
        kind: 'url',
        placeholder: 'https://… (o sube un archivo abajo)',
        maxLength: FIELD_MAX.url,
      },
      { name: 'file', label: 'Archivo', kind: 'file-policy' },
    ],
  },
  {
    title: 'Enlaces',
    collection: 'departmentLinks',
    entityName: 'enlace',
    entityNamePlural: 'enlaces',
    entityGender: 'm',
    rows: links.list(db, department.name).map((link) => ({ ...link })),
    columns: [
      { key: 'label', label: 'Nombre' },
      { key: 'url', label: 'Dirección', kind: 'muted' },
    ],
    fields: [
      { name: 'label', label: 'Nombre', kind: 'text', required: true, maxLength: FIELD_MAX.name },
      { name: 'url', label: 'Dirección', kind: 'url', required: true, placeholder: 'https://…', maxLength: FIELD_MAX.url },
    ],
  },
  {
    title: 'Avisos',
    collection: 'departmentNotices',
    entityName: 'aviso',
    entityNamePlural: 'avisos',
    entityGender: 'm',
    rows: notices.list(db, department.name).map((notice) => ({
      ...notice,
      kindLabel: labelOf(noticeKinds, notice.kind),
    })),
    columns: [
      { key: 'date', label: 'Fecha' },
      { key: 'body', label: 'Aviso', kind: 'muted' },
      { key: 'kindLabel', label: 'Tipo', kind: 'muted' },
    ],
    fields: [
      { name: 'date', label: 'Fecha', kind: 'date', required: true },
      { name: 'body', label: 'Aviso', kind: 'textarea', required: true, maxLength: FIELD_MAX.longText },
      {
        name: 'kind',
        label: 'Tipo',
        kind: 'select',
        required: true,
        options: noticeKinds.map(({ id, label }) => ({ value: id, label })),
      },
    ],
  },
];
---

<AdminLayout title={department.name} crumbs={['Departamentos']}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <BackLink href="/admin/departamentos" label="Departamentos" />
    <p class="text-sm text-cap-text-soft">
      Contenido de la <a href={`/departamentos/${department.slug}`} class={inlineLinkClass}>página pública del departamento</a>.
      El equipo se administra en <a href="/admin/contactos" class={inlineLinkClass}>Contactos</a>.
    </p>
  </div>
  {
    sections.map((section) => (
      <section class={cardClass}>
        <CollectionManager
          client:load
          collection={section.collection}
          entityName={section.entityName}
          entityNamePlural={section.entityNamePlural}
          entityGender={section.entityGender}
          title={section.title}
          createVariant="secondary"
          rows={section.rows}
          columns={section.columns}
          fields={section.fields}
          fixedValues={{ department: department.name }}
        />
      </section>
    ))
  }
</AdminLayout>
