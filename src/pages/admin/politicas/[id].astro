---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BackLink from '../../../components/admin/BackLink.astro';
import PolicyEditor from '../../../components/admin/PolicyEditor.vue';
import { labelOf, policyStatuses } from '../../../data/policies';
import { policyBadgeClass } from '../../../lib/policyBadges';
import { inlineLinkClass } from '../../../lib/capClasses';
import { getDb } from '../../../lib/db';
import { getPolicy } from '../../../lib/policies';
import { listDepartments } from '../../../lib/departments';

const db = getDb();
const policy = getPolicy(db, Number(Astro.params.id));
if (!policy) return Astro.redirect('/admin/politicas');

const isDraft = policy.status === 'draft';
const departments = listDepartments(db);
---

<AdminLayout title={policy.title} crumbs={['Políticas']}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <BackLink href="/admin/politicas" label="Todas las políticas" />
    <div class="flex flex-wrap items-center gap-3 text-sm text-cap-text-soft">
      <span class={policyBadgeClass(policy.status)}><span class="h-1.5 w-1.5 rounded-full bg-current"></span>{labelOf(policyStatuses, policy.status)}</span>
      {isDraft
        ? <span>Borrador: no aparece en el portal hasta publicar una versión.</span>
        : (
          <span>Visible en el portal: <a href={`/politicas/${policy.slug}`} class={inlineLinkClass}>ver ficha pública</a></span>
        )}
    </div>
  </div>
  <PolicyEditor client:load policy={policy} departments={departments} />
</AdminLayout>
