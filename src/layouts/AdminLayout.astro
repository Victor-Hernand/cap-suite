---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import ThemeHead from '../components/shell/ThemeHead.astro';
import AppShell from '../components/shell/AppShell.astro';
import { buildAdminNavigation } from '../data/navigation';
import { company } from '../design/company.js';
import { getDb, counts } from '../lib/db';

interface Props {
  title: string;
  crumbs?: string[];
}

const { title, crumbs } = Astro.props;
const navigation = buildAdminNavigation(counts(getDb()));
const user = { name: 'Administrador', caption: company.name, logoutAction: '/admin/logout' };
---

<html lang="es">
  <head>
    <ThemeHead title={`${title} — Admin CAP Suite`} />
    <ClientRouter />
  </head>
  <body class="bg-cap-page">
    <AppShell
      title={title}
      crumbs={crumbs}
      systemName="Administración"
      navigation={navigation}
      user={user}
      portalLink={{ label: 'Ver el portal', href: '/' }}
    >
      <slot />
    </AppShell>
  </body>
</html>
