---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PolicyEditor from '../../../components/admin/PolicyEditor.vue';
import { getDb } from '../../../lib/db';
import { listDepartments } from '../../../lib/departments';

const departments = listDepartments(getDb());
---

<AdminLayout title="Nueva política" active="politicas">
  <a href="/admin/politicas" class="text-xs font-semibold text-muted hover:text-ink">← Todas las políticas</a>
  <h1 class="mt-2 text-2xl font-extrabold">Nueva política</h1>
  <p class="mt-1 text-sm text-body">Se guarda como borrador. Publícala cuando tenga el documento oficial.</p>
  <div class="mt-5">
    <PolicyEditor client:load departments={departments} />
  </div>
</AdminLayout>
