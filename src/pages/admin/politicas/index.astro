---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PolicyTable from '../../../components/admin/PolicyTable.vue';
import { labelOf, policyStatuses, policyTypes } from '../../../data/policies';
import { getDb } from '../../../lib/db';
import { listPolicies } from '../../../lib/policies';

const rows = listPolicies(getDb()).map((policy) => ({
  id: policy.id,
  title: policy.title,
  department: policy.department,
  typeLabel: labelOf(policyTypes, policy.type),
  status: policy.status,
  statusLabel: labelOf(policyStatuses, policy.status),
  version: policy.version ?? '',
}));
---

<AdminLayout title="Políticas">
  <PolicyTable client:load rows={rows} summary={`${rows.length} documentos normativos`} />
</AdminLayout>
