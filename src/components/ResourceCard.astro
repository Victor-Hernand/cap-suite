---
import type { ResourceRow } from '../lib/db';
import { resourceTypes } from '../data/categories';
import { statusBadgeClass } from '../design/statuses.js';

interface Props {
  resource: ResourceRow;
}

const { resource } = Astro.props;
const type = resourceTypes.find((resourceType) => resourceType.id === resource.type);
const href = resource.url ?? `/files/${resource.filePath}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="flex items-start gap-3 rounded-cap-card border border-cap-divider bg-cap-card p-5 transition-colors duration-cap-fast ease-cap hover:bg-cap-card-2"
>
  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-cap-control bg-cap-red-200 text-cap-red-800 dark:bg-cap-red-600/20 dark:text-cap-brand-soft" aria-hidden="true">
    <i class={`mdi mdi-${type?.icon ?? 'file-outline'} text-xl leading-none`}></i>
  </span>
  <span class="min-w-0 flex-1">
    <span class="block text-sm font-semibold text-gray-900 dark:text-gray-100">
      {resource.name}<span class="sr-only"> (se abre en una pestaña nueva)</span>
    </span>
    <span class="mt-1 block text-sm text-cap-text-soft">{resource.description}</span>
    <span class={`mt-3 ${statusBadgeClass('neutral')}`}>{type?.badge ?? resource.type}</span>
  </span>
  <i class="mdi mdi-open-in-new shrink-0 text-base leading-none text-cap-text-soft" aria-hidden="true"></i>
</a>
