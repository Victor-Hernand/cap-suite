{
  "baseUrl": "http://localhost:4321",
  "viewport": { "width": 1440, "height": 900 },
  "login": {
    "url": "/admin/login",
    "userSelector": "#password",
    "passwordSelector": "#password",
    "submitSelector": "button[type=submit]"
  },
  "steps": [
    { "goto": "/politicas" },
    { "wait": 800 },
    { "screenshot": "01-biblioteca", "caption": "Biblioteca de políticas" },
    { "fill": { "selector": "input[type=search]", "value": "compra" } },
    { "wait": 400 },
    { "screenshot": "02-filtros", "caption": "Búsqueda y filtros de la biblioteca", "fullPage": false },
    { "goto": "/politicas/politicas-de-reuniones-virtuales-con-gerencia-administrativa" },
    { "wait": 500 },
    { "screenshot": "03-ficha-politica", "caption": "Ficha de una política" },
    { "goto": "/departamentos" },
    { "wait": 500 },
    { "screenshot": "04-departamentos", "caption": "Listado de departamentos" },
    { "goto": "/departamentos/compras-e-importaciones" },
    { "wait": 500 },
    { "screenshot": "05-pagina-departamento", "caption": "Página de un departamento" },
    { "goto": "/admin/politicas" },
    { "wait": 800 },
    { "screenshot": "06-admin-politicas", "caption": "Listado de políticas en administración" },
    { "goto": "/admin/politicas/nueva" },
    { "wait": 800 },
    { "screenshot": "07-nueva-politica", "caption": "Formulario de una política nueva" },
    { "goto": "/admin/politicas/1" },
    { "wait": 800 },
    { "screenshot": "08-editar-politica", "caption": "Edición de una política publicada" },
    { "click": "text=Publicar versión" },
    { "wait": 500 },
    { "screenshot": "09-publicar-version", "caption": "Ventana para publicar una versión", "fullPage": false },
    { "goto": "/admin/departamentos" },
    { "wait": 500 },
    { "screenshot": "10-admin-departamentos", "caption": "Departamentos en administración" },
    { "goto": "/admin/departamentos/compras-e-importaciones" },
    { "wait": 800 },
    { "screenshot": "11-contenido-departamento", "caption": "Contenido de un departamento en administración" }
  ]
}
