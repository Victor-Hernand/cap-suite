---
import AdminLayout from '../../layouts/AdminLayout.astro';
import CollectionManager from '../../components/admin/CollectionManager.vue';
import type { Column, Field } from '../../components/admin/types';
import { getDb, listContacts } from '../../lib/db';
import { departments } from '../../data/departments';
import { FIELD_MAX, PHONE_HINT } from '../../lib/fieldRules';

const rows = listContacts(getDb()).map((contact) => ({
  ...contact,
  photoUrl: contact.photoPath?.startsWith('http') ? contact.photoPath : '',
}));

const columns: Column[] = [
  { key: 'name', label: 'Nombre' },
  { key: 'role', label: 'Cargo', kind: 'muted' },
  { key: 'department', label: 'Departamento', kind: 'muted' },
  { key: 'company', label: 'Empresa', kind: 'muted' },
];

const fields: Field[] = [
  { name: 'name', label: 'NOMBRE', kind: 'text', required: true, maxLength: FIELD_MAX.name },
  { name: 'role', label: 'CARGO', kind: 'text', required: true, maxLength: FIELD_MAX.shortText },
  {
    name: 'department',
    label: 'DEPARTAMENTO',
    kind: 'select',
    required: true,
    options: departments.map((department) => ({ value: department, label: department })),
  },
  { name: 'company', label: 'EMPRESA', kind: 'text', required: true, maxLength: FIELD_MAX.shortText },
  {
    name: 'phone',
    label: 'TELÉFONO',
    kind: 'tel',
    required: true,
    placeholder: '+504 9999-9999',
    hint: PHONE_HINT,
    maxLength: FIELD_MAX.phone,
  },
  { name: 'email', label: 'CORREO', kind: 'email', required: true, maxLength: FIELD_MAX.email },
  { name: 'extension', label: 'EXTENSIÓN', kind: 'text', placeholder: 'opcional, solo números', maxLength: FIELD_MAX.extension },
  { name: 'photo', label: 'FOTO', kind: 'file-logo' },
  { name: 'photoUrl', label: 'O URL DE FOTO EXTERNA', kind: 'url', placeholder: 'https://… (opcional)', maxLength: FIELD_MAX.url },
];
---

<AdminLayout title="Contactos" active="contactos">
  <h1 class="text-2xl font-extrabold">Contactos</h1>
  <p class="mt-1 text-sm text-body">{rows.length} contactos del directorio</p>
  <div class="mt-5">
    <CollectionManager
      client:load
      collection="contacts"
      entityName="contacto"
      entityGender="m"
      entityNamePlural="contactos"
      rows={rows}
      columns={columns}
      fields={fields}
    />
  </div>
</AdminLayout>
