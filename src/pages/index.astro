---
import Layout from '../layouts/Layout.astro';
import { getDb, listApps, counts, listRecentResources } from '../lib/db';
import { listVisiblePolicies } from '../lib/policies';
import { logoSrc } from '../lib/assets';
import { company } from '../design/company.js';
import { appCategories, resourceTypes } from '../data/categories';
import { policyCountLabel } from '../data/policies';
import EmptyState from '../components/EmptyState.astro';

const QUICK_ACCESS_LIMIT = 8;

const db = getDb();
const apps = listApps(db);
const quickAccess = [...apps.filter((app) => app.featured), ...apps.filter((app) => !app.featured)].slice(0, QUICK_ACCESS_LIMIT);
const totals = counts(db);
const visiblePoliciesCount = listVisiblePolicies(db).length;
const recentResources = listRecentResources(db, 4).map((resource) => ({
  ...resource,
  href: resource.url ?? `/files/${resource.filePath}`,
  icon: resourceTypes.find((type) => type.id === resource.type)?.icon ?? 'file-outline',
}));

function plural(total: number, singular: string, pluralForm: string): string {
  return `${total} ${total === 1 ? singular : pluralForm}`;
}

const portalAccesses = [
  { id: 'recursos', name: 'Recursos', description: 'Manuales, plantillas, carpetas y enlaces.', icon: 'folder-outline', href: '/recursos', total: plural(totals.resources, 'recurso', 'recursos') },
  { id: 'politicas', name: 'Políticas', description: 'Políticas, procedimientos e instructivos vigentes.', icon: 'file-document-outline', href: '/politicas', total: policyCountLabel(visiblePoliciesCount) },
  { id: 'departamentos', name: 'Departamentos', description: 'Procesos, formatos, equipo y avisos por área.', icon: 'office-building-outline', href: '/departamentos', total: plural(totals.departments, 'departamento', 'departamentos') },
  { id: 'contactos', name: 'Contactos', description: 'Directorio con teléfonos y correos.', icon: 'account-box-outline', href: '/contactos', total: plural(totals.contacts, 'persona', 'personas') },
  { id: 'empresas', name: 'Empresas', description: 'Las empresas que forman el grupo.', icon: 'domain', href: '/empresas', total: plural(totals.companies, 'empresa', 'empresas') },
];

const tegucigalpaHour = Number(
  new Intl.DateTimeFormat('es-HN', { hour: 'numeric', hour12: false, timeZone: 'America/Tegucigalpa' }).format(new Date()),
);
const greeting = tegucigalpaHour < 12 ? 'Buenos días' : tegucigalpaHour < 18 ? 'Buenas tardes' : 'Buenas noches';
const dateLabel = new Intl.DateTimeFormat('es-HN', {
  weekday: 'long',
  day: 'numeric',
  month: 'short',
  timeZone: 'America/Tegucigalpa',
}).format(new Date());

function categoryLabelOf(categoryId: string): string {
  return appCategories.find((category) => category.id === categoryId)?.label ?? categoryId;
}
---

<Layout title="Inicio">
  <div>
    <div class="cap-module-home">
      <small class="cap-module-home__eyebrow">{greeting},</small>
      <h2 class="cap-module-home__name">{company.name}</h2>
      <p class="cap-module-home__hint">Hoy es {dateLabel}. Tienes {plural(apps.length, 'aplicación', 'aplicaciones')} a la mano.</p>
    </div>

    {recentResources.length > 0 && (
      <nav class="cap-module-recent relative" aria-label="Recursos recientes">
        <span class="cap-module-recent__label">Recientes</span>
        {recentResources.map((resource) => (
          <a class="cap-module-recent__link" href={resource.href} target="_blank" rel="noopener">
            <i class={`mdi mdi-${resource.icon}`} aria-hidden="true"></i>{resource.name}
            <span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>
        ))}
      </nav>
    )}

    <section class="cap-module-group" aria-labelledby="cap-module-group-0">
      <div class="cap-module-group__head">
        <h3 id="cap-module-group-0" class="cap-module-group__title">Accesos rápidos</h3>
        {apps.length > 0 && (
          <a href="/apps" class="cap-module-group__count underline decoration-gray-400 underline-offset-2 hover:decoration-current">Ver las {plural(apps.length, 'aplicación', 'aplicaciones')}</a>
        )}
      </div>
      {quickAccess.length === 0 ? (
        <EmptyState icon="apps" title="Aún no hay aplicaciones registradas" detail="Se agregan desde el panel de administración." />
      ) : (
        <div class="cap-module-grid cap-stagger">
          {quickAccess.map((app) => {
            const logo = logoSrc(app.logoPath);
            return (
              <a class="cap-module-card" href={app.url} target="_blank" rel="noopener" aria-labelledby={`cap-module-app-${app.id}-name`}>
                <div class="cap-module-card__top">
                  <span class="cap-module-tile">
                    {logo ? <img src={logo} alt="" width="24" height="24" class="h-6 w-6 rounded-md object-contain" /> : <i class="mdi mdi-application-outline" aria-hidden="true"></i>}
                  </span>
                </div>
                <div>
                  <h4 class="cap-module-card__name" id={`cap-module-app-${app.id}-name`}>{app.name}</h4>
                  <p class="cap-module-card__desc" title={app.description}>{app.description}</p>
                </div>
                <div class="cap-module-card__foot">
                  <span>{categoryLabelOf(app.category)}</span>
                  <span class="sr-only">(se abre en una pestaña nueva)</span>
                  <i class="cap-module-card__arrow mdi mdi-open-in-new" aria-hidden="true"></i>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </section>

    <section class="cap-module-group" aria-labelledby="cap-module-group-1">
      <div class="cap-module-group__head">
        <h3 id="cap-module-group-1" class="cap-module-group__title">Portal</h3>
        <span class="cap-module-group__count">{plural(portalAccesses.length, 'sección', 'secciones')}</span>
      </div>
      <div class="cap-module-grid cap-stagger">
        {portalAccesses.map((access) => (
          <a class="cap-module-card" href={access.href} aria-labelledby={`cap-module-${access.id}-name`}>
            <div class="cap-module-card__top">
              <span class="cap-module-tile"><i class={`mdi mdi-${access.icon}`} aria-hidden="true"></i></span>
            </div>
            <div>
              <h4 class="cap-module-card__name" id={`cap-module-${access.id}-name`}>{access.name}</h4>
              <p class="cap-module-card__desc" title={access.description}>{access.description}</p>
            </div>
            <div class="cap-module-card__foot">
              <span class="tabular-nums">{access.total}</span>
              <i class="cap-module-card__arrow mdi mdi-arrow-right" aria-hidden="true"></i>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
