---
import { isActiveHref, itemAriaLabel, itemIconClass } from '../../data/navigation';
import type { NavGroup, NavItem, PortalLink, ShellUser as ShellUserData } from '../../data/navigation';
import ShellUser from './ShellUser.astro';

interface Props {
  navigation: NavGroup[];
  user?: ShellUserData | null;
  portalLink?: PortalLink | null;
}

const { navigation, user = null, portalLink = null } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = (item: NavItem) => isActiveHref(pathname, item.href);
---

<div class="cap-shell-sheet" id="cap-more-sheet" role="dialog" aria-modal="true" aria-label="Menú completo" data-open="false">
  <div class="cap-shell-sheet__backdrop" data-cap-sheet-backdrop></div>
  <div class="cap-shell-sheet__panel cap-glass">
    <div class="cap-shell-sheet__handle" data-cap-sheet-handle></div>
    {navigation.map((group) => (
      <Fragment>
        <p class="cap-shell-sidebar__group-label">{group.label}</p>
        {group.items.map((item) => (
          <a
            class="cap-shell-sidebar__item"
            href={item.href}
            aria-current={isActive(item) ? 'page' : undefined}
            aria-label={itemAriaLabel(item)}
          >
            <i class:list={['cap-shell-sidebar__icon mdi', itemIconClass(item, isActive(item))]} aria-hidden="true"></i>{item.label}
            {item.count ? <span class="cap-shell-sidebar__count">{item.count}</span> : null}
          </a>
        ))}
      </Fragment>
    ))}
    {portalLink && (
      <a class="cap-shell-sidebar__item" href={portalLink.href}>
        <i class="cap-shell-sidebar__icon mdi mdi-swap-horizontal" aria-hidden="true"></i>{portalLink.label}
      </a>
    )}
    <button class="cap-shell-sidebar__item" type="button" data-cap-theme-toggle aria-label="Alternar modo oscuro">
      <i class="cap-shell-sidebar__icon mdi mdi-weather-night" aria-hidden="true"></i>Modo oscuro<span class="cap-shell-sidebar__switch" aria-hidden="true"></span>
    </button>
    {user && <ShellUser user={user} />}
  </div>
</div>
