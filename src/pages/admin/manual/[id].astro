---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PdfViewer from '../../../components/admin/PdfViewer.vue';
import { getDb, getManual } from '../../../lib/db';
import { loomEmbedUrl } from '../../../lib/loom';
import { basename } from 'node:path';

const manual = getManual(getDb(), Number(Astro.params.id));
if (!manual) return Astro.redirect('/admin/manual');

const videoEmbedUrl = loomEmbedUrl(manual.videoUrl);
// Versionada con el nombre del archivo: la caché se renueva al reemplazar el PDF.
const pdfUrl = manual.pdfPath
  ? `/admin/manual/${manual.id}/pdf?v=${encodeURIComponent(basename(manual.pdfPath))}`
  : null;
const sectionLabelClass = 'font-mono text-[10px] uppercase tracking-widest text-muted';
---

<AdminLayout title={manual.title} active="manual">
  <a href="/admin/manual" class="text-xs font-semibold text-muted hover:text-ink">← Todos los manuales</a>
  <h1 class="mt-2 text-2xl font-extrabold">{manual.title}</h1>
  {manual.description && <p class="mt-1 max-w-4xl text-sm text-body">{manual.description}</p>}

  {videoEmbedUrl && (
    <section class="mt-6 max-w-4xl">
      <h2 class={sectionLabelClass}>Video</h2>
      <div class="mt-3 aspect-video overflow-hidden rounded-xl border border-edge bg-ink-solid">
        <iframe
          src={videoEmbedUrl}
          title={`Video: ${manual.title}`}
          class="h-full w-full"
          allow="fullscreen"
          allowfullscreen
        ></iframe>
      </div>
    </section>
  )}

  {pdfUrl && (
    <section class="mt-8 max-w-4xl">
      <div class="flex items-baseline justify-between gap-3">
        <h2 class={sectionLabelClass}>Documento PDF</h2>
        <div class="flex gap-4 text-xs font-semibold">
          <a href={pdfUrl} target="_blank" rel="noopener" class="text-ink hover:underline">Abrir en pestaña nueva ↗</a>
          <a href={pdfUrl} download class="text-ink hover:underline">Descargar</a>
        </div>
      </div>
      <div class="mt-3">
        <PdfViewer client:visible src={pdfUrl} title={`PDF: ${manual.title}`} />
      </div>
    </section>
  )}
</AdminLayout>
