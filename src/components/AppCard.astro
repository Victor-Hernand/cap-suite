---
import { getDb, companyColorFor } from '../lib/db';
import { appCategories } from '../data/categories';
import type { AppRow } from '../lib/db';
import { logoSrc } from '../lib/assets';
import { statusBadgeClass } from '../design/statuses.js';
import { brandTileClass, cardClass } from '../lib/capClasses';

interface Props {
  app: AppRow;
}

const { app } = Astro.props;
const companyColor = companyColorFor(getDb(), app.companyLabel);
const categoryLabel = appCategories.find((category) => category.id === app.category)?.label ?? app.category;
const logo = logoSrc(app.logoPath);
---

<a
  href={app.url}
  target="_blank"
  rel="noopener"
  class:list={['flex flex-col', cardClass, 'transition-colors duration-cap-fast ease-cap hover:bg-cap-card-2']}
>
  <span class="flex items-start gap-3">
    {logo ? (
      <img src={logo} alt="" width="40" height="40" class="h-10 w-10 shrink-0 rounded-cap-control object-contain" />
    ) : (
      <span class={brandTileClass} aria-hidden="true">
        <i class="mdi mdi-application-outline text-xl leading-none"></i>
      </span>
    )}
    <span class="min-w-0 flex-1">
      <span class="flex flex-wrap items-center gap-2">
        <span class="text-sm font-semibold text-gray-900 dark:text-gray-100">{app.name}</span>
        {app.badge && <span class={statusBadgeClass('neutral')}>{app.badge}</span>}
      </span>
      <span class="mt-1 line-clamp-2 block text-xs text-cap-text-soft" title={app.description}>{app.description}</span>
    </span>
    <i class="mdi mdi-open-in-new shrink-0 text-base leading-none text-cap-text-soft" aria-hidden="true"></i>
    <span class="sr-only"> (se abre en una pestaña nueva)</span>
  </span>
  <span class="mt-4 flex items-center gap-2 text-xs text-cap-text-soft">
    {companyColor && <span class="h-2.5 w-2.5 shrink-0 rounded-sm" style={`background-color: ${companyColor}`} aria-hidden="true"></span>}
    <span class="truncate">{app.companyLabel ? `${app.companyLabel} · ${categoryLabel}` : categoryLabel}</span>
  </span>
</a>
