---
import Layout from '../layouts/Layout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { getDb, listResources } from '../lib/db';
import { resourceTypes } from '../data/categories';
import { emptyStateClass } from '../lib/capClasses';

const db = getDb();
const resources = listResources(db);

const requestedType = Astro.url.searchParams.get('tipo') ?? '';
const selectedType = resourceTypes.some((type) => type.id === requestedType) ? requestedType : '';

const filterItems = [
  { id: '', label: 'Todos', href: '/recursos', count: resources.length },
  ...resourceTypes.map((type) => ({
    id: type.id,
    label: type.label,
    href: `/recursos?tipo=${type.id}`,
    count: resources.filter((resource) => resource.type === type.id).length,
  })),
];

const groups = resourceTypes
  .filter((type) => !selectedType || type.id === selectedType)
  .map((type) => ({ id: type.id, label: type.label, items: resources.filter((resource) => resource.type === type.id) }))
  .filter((group) => group.items.length > 0);
---

<Layout title="Recursos">
  {resources.length === 0 ? (
    <div class={emptyStateClass}>
      <i class="mdi mdi-folder-outline text-cap-icon text-gray-400" aria-hidden="true"></i>
      <p class="mt-3 font-display text-base font-semibold text-gray-900 dark:text-gray-100">Aún no hay recursos publicados</p>
      <p class="mt-1 text-sm text-cap-text-soft">Manuales, plantillas, carpetas y enlaces aparecerán aquí.</p>
    </div>
  ) : (
    <>
      <nav class="cap-segmented self-start" aria-label="Filtrar por tipo" data-cap-pill-nav>
        <span class="cap-segmented__pill" aria-hidden="true" data-cap-pill></span>
        {filterItems.map((item) => (
          <a class="cap-segmented__item" href={item.href} aria-current={item.id === selectedType ? 'page' : undefined}>
            {item.label}<span class="cap-segmented__count">{item.count}</span>
          </a>
        ))}
      </nav>

      {groups.length === 0 && (
        <div class="flex flex-col items-center justify-center px-6 py-12 text-center">
          <i class="mdi mdi-filter-off-outline text-cap-icon text-gray-400" aria-hidden="true"></i>
          <p class="mt-3 font-display text-base font-semibold text-gray-900 dark:text-gray-100">Ningún recurso coincide con los filtros</p>
          <p class="mt-1 text-sm text-cap-text-soft">Este tipo aún no tiene recursos publicados.</p>
          <div class="mt-4"><a href="/recursos" class="cap-button cap-button--secondary">Limpiar filtros</a></div>
        </div>
      )}

      {groups.map((group) => (
        <section aria-labelledby={`resources-${group.id}`} class="flex flex-col gap-3">
          <div class="flex items-baseline justify-between gap-3">
            <h2 id={`resources-${group.id}`} class="font-display text-lg font-semibold text-gray-900 dark:text-gray-100">{group.label}</h2>
            <span class="text-xs text-cap-text-soft tabular-nums">
              {group.items.length} {group.items.length === 1 ? 'recurso' : 'recursos'}
            </span>
          </div>
          <div class="cap-stagger grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
            {group.items.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      ))}
    </>
  )}
</Layout>
