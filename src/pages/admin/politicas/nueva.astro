---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BackLink from '../../../components/admin/BackLink.astro';
import PolicyEditor from '../../../components/admin/PolicyEditor.vue';
import { getDb } from '../../../lib/db';
import { listDepartments } from '../../../lib/departments';

const departments = listDepartments(getDb());
---

<AdminLayout title="Nueva política" crumbs={['Políticas']}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <BackLink href="/admin/politicas" label="Todas las políticas" />
    <p class="text-sm text-cap-text-soft">Se guarda como borrador. Publícala cuando tenga el documento oficial.</p>
  </div>
  <PolicyEditor client:load departments={departments} />
</AdminLayout>
