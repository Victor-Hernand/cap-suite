---
import type { ContactRow } from '../lib/db';
import ContactAvatar from './ContactAvatar.astro';
import { contactPhoneHref, contactPhoneLabel } from '../lib/contacts';
import { iconButtonClass } from '../lib/capClasses';

interface Props {
  contact: ContactRow;
  /** Dentro de otra tarjeta va como tarjeta anidada secundaria del recetario. */
  nested?: boolean;
}

const { contact, nested = false } = Astro.props;
const containerClass = nested
  ? 'rounded-cap-control bg-cap-card-2 p-3'
  : 'min-h-16 rounded-cap-card border border-cap-divider bg-cap-card p-4';
---

<article class={`flex items-center gap-3 ${containerClass}`}>
  <ContactAvatar name={contact.name} photoPath={contact.photoPath} />
  <div class="min-w-0 flex-1">
    <p class="truncate text-sm font-semibold text-gray-900 dark:text-gray-100">{contact.name}</p>
    <p class="truncate text-xs text-cap-text-soft">{contact.role} · {contact.department} · {contact.company}</p>
    <p class="truncate text-xs text-cap-text-soft tabular-nums">{contactPhoneLabel(contact)} · {contact.email}</p>
  </div>
  <div class="flex shrink-0 items-center gap-2">
    <a href={contactPhoneHref(contact)} aria-label={`Llamar a ${contact.name}`} title="Llamar" class={iconButtonClass}>
      <i class="mdi mdi-phone-outline text-xl leading-none" aria-hidden="true"></i>
    </a>
    <a href={`mailto:${contact.email}`} aria-label={`Escribir a ${contact.name}`} title={contact.email} class={iconButtonClass}>
      <i class="mdi mdi-email-outline text-xl leading-none" aria-hidden="true"></i>
    </a>
  </div>
</article>
