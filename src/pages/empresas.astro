---
import Layout from '../layouts/Layout.astro';
import CompanyCard from '../components/CompanyCard.astro';
import { getDb, listCompanies, listApps } from '../lib/db';
import { company as installedCompany } from '../design/company.js';
import { cardClass } from '../lib/capClasses';
import EmptyState from '../components/EmptyState.astro';

const db = getDb();
const apps = listApps(db);

const companies = listCompanies(db).map((company) => {
  const companyApps = apps.filter((app) => app.companyLabel === company.name);
  const erp = companyApps.find((app) => app.category === 'erp');
  return {
    company,
    systemsCount: companyApps.length,
    erpUrl: erp?.url ?? null,
  };
});

const marketsCount = new Set(
  companies
    .map(({ company }) => company.segment.match(/\b(B2B|B2C)\b/)?.[1])
    .filter(Boolean),
).size;

const summary = [
  { value: companies.length, label: 'Empresas' },
  { value: marketsCount, label: 'Mercados (B2B · B2C)' },
  { value: apps.length, label: 'Sistemas del grupo' },
];
---

<Layout title="Empresas">
  <p class="max-w-3xl text-sm text-cap-text-soft">
    {installedCompany.name} es un conglomerado automotriz líder en Honduras. Cada empresa cubre un eslabón de la cadena:
    importación, distribución, venta al detalle, servicio e instalación, y logística.
  </p>

  {companies.length === 0 ? (
    <EmptyState icon="domain" title="Aún no hay empresas registradas" detail="Se agregan desde el panel de administración." />
  ) : (
    <>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        {summary.map((stat) => (
          <div class={cardClass}>
            <p class="text-xs font-medium text-cap-text-soft">{stat.label}</p>
            <p class="mt-3 font-display text-3xl font-semibold tabular-nums text-gray-900 dark:text-gray-100" data-cap-count={stat.value} data-cap-format="integer">{stat.value}</p>
          </div>
        ))}
      </div>

      <div class="cap-stagger grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        {companies.map(({ company, systemsCount, erpUrl }) => (
          <CompanyCard company={company} systemsCount={systemsCount} erpUrl={erpUrl} />
        ))}
      </div>
    </>
  )}
</Layout>
