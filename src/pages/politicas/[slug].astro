---
import Layout from '../../layouts/Layout.astro';
import PolicyBadges from '../../components/PolicyBadges.astro';
import { getDb } from '../../lib/db';
import { getVisiblePolicyBySlug } from '../../lib/policies';
import { getDepartmentByName } from '../../lib/departments';
import { attachmentKinds, labelOf, policyClassifications } from '../../data/policies';
import { policyBadgeClass } from '../../lib/policyBadges';
import { formatDate } from '../../lib/dates';
import BackLink from '../../components/BackLink.astro';
import { cardClass, sectionSubtitleClass, sectionTitleClass } from '../../lib/capClasses';

const SUPERVISOR = 'Mejora Continua y Automatización';
const EMBEDDABLE_IMAGE = /\.(png|jpe?g|webp)$/i;

const db = getDb();
const policy = getVisiblePolicyBySlug(db, Astro.params.slug ?? '');
if (!policy) return new Response(null, { status: 404 });

const department = getDepartmentByName(db, policy.department);
const officialHref = policy.officialFilePath ? `/files/${policy.officialFilePath}` : null;
const officialIsImage = policy.officialFilePath ? EMBEDDABLE_IMAGE.test(policy.officialFilePath) : false;

const textSections = [
  { title: 'Objetivo', text: policy.objective },
  { title: 'Ámbito de aplicación', text: policy.scope },
].filter((section) => section.text);

const recordFacts = [
  { label: 'Clasificación', value: labelOf(policyClassifications, policy.classification) },
  { label: 'Vigencia desde', value: formatDate(policy.effectiveDate) },
  { label: 'Próxima revisión', value: formatDate(policy.nextReviewDate) },
  { label: 'Responsable del documento', value: policy.owner },
  { label: 'Aprobador', value: policy.approver },
  { label: 'Supervisado por', value: SUPERVISOR },
  { label: 'Documentos relacionados', value: policy.relatedDocuments },
  { label: 'Indicadores asociados', value: policy.indicators },
].filter((fact) => fact.value);

const proseClass = 'mt-2 whitespace-pre-line text-sm leading-relaxed text-gray-700 dark:text-gray-300';
const textLinkClass = 'underline decoration-gray-400 underline-offset-2 hover:decoration-current';
---

<Layout title={policy.title} crumbs={['Políticas']}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <BackLink href="/politicas" label="Volver al Centro de Políticas" />
    {officialHref && (
      <a href={officialHref} download class="cap-button cap-button--primary">
        <i class="mdi mdi-download text-xl leading-none" aria-hidden="true"></i>Descargar oficial
      </a>
    )}
  </div>

  {policy.status === 'obsolete' && (
    <div role="status" class="cap-alert cap-alert--warning">
      <i class="cap-alert__icon mdi mdi-alert-outline" aria-hidden="true"></i>
      <div><strong class="cap-alert__title">Esta política está obsoleta</strong><span class="cap-alert__detail">Ya no está vigente. Consulta la versión vigente antes de aplicarla.</span></div>
    </div>
  )}

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <article class={cardClass}>
      <PolicyBadges
        type={policy.type}
        status={policy.status}
        classification={policy.classification}
        version={policy.version}
        effectiveDate={policy.effectiveDate}
      />

      {policy.summary && (
        <div class="mt-4 rounded-cap-control bg-cap-card-2 p-3 text-sm text-gray-700 dark:text-gray-300">
          <strong class="font-semibold text-gray-900 dark:text-gray-100">Resumen:</strong> {policy.summary}
        </div>
      )}

      {textSections.map((section) => (
        <section class="mt-6">
          <h2 class={sectionSubtitleClass}>{section.title}</h2>
          <p class={proseClass}>{section.text}</p>
        </section>
      ))}

      {policy.guidelines.length > 0 && (
        <section class="mt-6">
          <h2 class={sectionSubtitleClass}>Lineamientos</h2>
          <ol class="mt-3 flex flex-col gap-3">
            {policy.guidelines.map((guideline, index) => (
              <li class="rounded-cap-control bg-cap-card-2 p-3">
                <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">{index + 1}. {guideline.title}</h3>
                <p class={proseClass}>{guideline.body}</p>
              </li>
            ))}
          </ol>
        </section>
      )}

      {policy.attachments.length > 0 && (
        <section class="mt-6">
          <h2 class={sectionSubtitleClass}>Anexos</h2>
          <ul class="mt-3 flex flex-col gap-2">
            {policy.attachments.map((attachment) => {
              const isFile = attachment.kind === 'file';
              const href = isFile ? `/files/${attachment.filePath}` : attachment.url;
              return (
                <li class="flex items-center gap-3 text-sm text-gray-900 dark:text-gray-100">
                  <span class={policyBadgeClass(attachment.kind)}>{labelOf(attachmentKinds, attachment.kind)}</span>
                  <a href={href} target={isFile ? undefined : '_blank'} rel={isFile ? undefined : 'noopener'} class={textLinkClass}>
                    {attachment.label}
                  </a>
                  {!isFile && (
                    <>
                      <i class="mdi mdi-open-in-new text-base leading-none text-cap-text-soft" aria-hidden="true"></i>
                      <span class="sr-only"> (se abre en una pestaña nueva)</span>
                    </>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {officialHref && officialIsImage && (
        <img src={officialHref} alt={`Documento oficial: ${policy.title}`} class="mt-6 w-full rounded-cap-control border border-cap-divider" />
      )}
    </article>

    <aside class="flex flex-col gap-6 self-start">
      <section class={cardClass} aria-labelledby="policy-record-title">
        <h2 id="policy-record-title" class={sectionTitleClass}>Ficha</h2>
        <dl class="mt-4 grid gap-x-6 gap-y-4 md:grid-cols-2 lg:grid-cols-1">
          <div>
            <dt class="text-xs font-medium text-cap-text-soft">Departamento</dt>
            <dd class="mt-1 text-sm text-gray-900 dark:text-gray-100">
              {department ? <a href={`/departamentos/${department.slug}`} class={textLinkClass}>{policy.department}</a> : policy.department}
            </dd>
          </div>
          {recordFacts.map((fact) => (
            <div>
              <dt class="text-xs font-medium text-cap-text-soft">{fact.label}</dt>
              <dd class="mt-1 whitespace-pre-line text-sm text-gray-900 dark:text-gray-100">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class={cardClass} aria-labelledby="policy-history-title">
        <h2 id="policy-history-title" class={sectionTitleClass}>Control de cambios</h2>
        {policy.versions.length === 0 ? (
          <p class="mt-2 text-sm text-cap-text-soft">Aún no hay cambios registrados.</p>
        ) : (
          <ol class="mt-4 space-y-4">
            {policy.versions.map((entry) => (
              <li class="flex gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cap-card-2 text-cap-text-soft" aria-hidden="true"><i class="mdi mdi-file-document-outline text-base leading-none"></i></span>
                <div class="min-w-0">
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100">{entry.version} · {entry.reason}</p>
                  <p class="text-xs text-cap-text-soft">{entry.author}, {formatDate(entry.date)}</p>
                </div>
              </li>
            ))}
          </ol>
        )}
      </section>
    </aside>
  </div>
</Layout>
