---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BackLink from '../../../components/admin/BackLink.astro';
import PdfViewer from '../../../components/admin/PdfViewer.vue';
import { cardClass, emptyStateClass, sectionTitleClass } from '../../../lib/capClasses';
import { getDb, getManual } from '../../../lib/db';
import { loomEmbedUrl } from '../../../lib/loom';
import { basename } from 'node:path';

const manual = getManual(getDb(), Number(Astro.params.id));
if (!manual) return Astro.redirect('/admin/manual');

const videoEmbedUrl = loomEmbedUrl(manual.videoUrl);
// Versionada con el nombre del archivo: la caché se renueva al reemplazar el PDF.
const pdfUrl = manual.pdfPath
  ? `/admin/manual/${manual.id}/pdf?v=${encodeURIComponent(basename(manual.pdfPath))}`
  : null;
---

<AdminLayout title={manual.title} crumbs={['Manuales']}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <BackLink href="/admin/manual" label="Todos los manuales" />
    {pdfUrl && (
      <div class="flex flex-wrap items-center gap-2">
        <a href={pdfUrl} target="_blank" rel="noopener" class="cap-button cap-button--secondary">
          <i class="mdi mdi-open-in-new text-xl leading-none" aria-hidden="true"></i>Abrir en pestaña nueva
        </a>
        <a href={pdfUrl} download class="cap-button cap-button--primary">
          <i class="mdi mdi-download text-xl leading-none" aria-hidden="true"></i>Descargar PDF
        </a>
      </div>
    )}
  </div>

  {manual.description && <p class="max-w-7xl text-sm text-cap-text-soft">{manual.description}</p>}

  {videoEmbedUrl && (
    <section class={`${cardClass} max-w-7xl`}>
      <h2 class={`${sectionTitleClass} mb-4`}>Video</h2>
      <div class="aspect-video overflow-hidden rounded-cap-control border border-cap-divider bg-cap-card-2">
        <iframe
          src={videoEmbedUrl}
          title={`Video: ${manual.title}`}
          class="h-full w-full"
          allow="fullscreen"
          allowfullscreen
        ></iframe>
      </div>
    </section>
  )}

  {pdfUrl && (
    <section class={`${cardClass} max-w-7xl`}>
      <h2 class={`${sectionTitleClass} mb-4`}>Documento PDF</h2>
      <PdfViewer client:visible src={pdfUrl} title={`PDF: ${manual.title}`} />
    </section>
  )}

  {!videoEmbedUrl && !pdfUrl && (
    <div class={emptyStateClass}>
      <i class="mdi mdi-book-open-outline text-cap-icon text-gray-400" aria-hidden="true"></i>
      <p class="mt-3 font-display text-base font-semibold text-gray-900 dark:text-gray-100">Este manual aún no tiene contenido</p>
      <p class="mt-1 text-sm text-cap-text-soft">Edítalo en Manuales para agregar un video de Loom o un PDF.</p>
    </div>
  )}
</AdminLayout>
