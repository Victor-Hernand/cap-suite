---
import type { CompanyRow } from '../lib/db';
import { logoSrc } from '../lib/assets';
import { statusBadgeClass } from '../design/statuses.js';

interface Props {
  company: CompanyRow;
  systemsCount?: number;
  erpUrl?: string | null;
}

const { company, systemsCount = 0, erpUrl = null } = Astro.props;

const logo = logoSrc(company.logoPath);
const monogram = company.name.replace(/[^a-zA-Z]/g, '').slice(0, 2).toUpperCase();

const marketMatch = company.segment.match(/\b(B2B|B2C)\b/);
const market = marketMatch?.[1] ?? null;
const segmentLabel = market
  ? company.segment.replace(/\s*\b(B2B|B2C)\b\s*/, ' ').trim()
  : company.segment;

const externalLinks = [
  { label: 'Abrir ERP', href: erpUrl },
  { label: 'Sitio web', href: company.url },
].filter((link) => link.href);
---

<article class="flex h-full flex-col rounded-cap-card border border-cap-divider bg-cap-card p-5">
  <div class="flex items-start gap-3">
    {logo ? (
      <img src={logo} alt={`Logo de ${company.name}`} width="40" height="40" class="h-10 w-10 shrink-0 rounded-cap-control border border-cap-divider object-contain p-1" />
    ) : (
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-cap-control bg-cap-card-2 font-display text-sm font-semibold text-gray-700 dark:text-gray-300" aria-hidden="true">
        {monogram}
      </span>
    )}
    <div class="min-w-0 flex-1">
      <h2 class="flex items-center gap-2 font-display text-base font-semibold text-gray-900 dark:text-gray-100">
        <span class="h-2.5 w-2.5 shrink-0 rounded-sm" style={`background-color: ${company.color}`} aria-hidden="true"></span>
        {company.name}
      </h2>
      <p class="mt-0.5 text-xs text-cap-text-soft">{segmentLabel}</p>
    </div>
    {market && <span class={statusBadgeClass('neutral')}>{market}</span>}
  </div>

  <p class="mt-4 text-sm italic text-cap-text-soft">“{company.slogan}”</p>
  <p class="mt-2 text-sm leading-relaxed text-gray-700 dark:text-gray-300">{company.description}</p>

  <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-cap-divider pt-4">
    <span class="text-xs text-cap-text-soft tabular-nums">{systemsCount} {systemsCount === 1 ? 'sistema' : 'sistemas'}</span>
    {externalLinks.length > 0 && (
      <span class="flex items-center gap-4">
        {externalLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-sm text-gray-700 underline decoration-gray-400 underline-offset-2 hover:decoration-current dark:text-gray-300">
            {link.label}
            <i class="mdi mdi-open-in-new text-base leading-none" aria-hidden="true"></i>
            <span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>
        ))}
      </span>
    )}
  </div>
</article>
