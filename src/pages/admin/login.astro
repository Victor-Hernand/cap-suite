---
import { actions } from 'astro:actions';
import '../../styles/global.css';
import AdminLogin from '../../components/shell/AdminLogin.astro';
import ThemeHead from '../../components/shell/ThemeHead.astro';

const result = Astro.getActionResult(actions.auth.login);
if (result && !result.error) return Astro.redirect('/admin');
---

<html lang="es">
  <head>
    <ThemeHead title="Acceso admin — CAP Suite" />
  </head>
  <body>
    <AdminLogin errorMessage={result?.error?.message ?? null} />
  </body>
</html>
