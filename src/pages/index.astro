---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AppCard from '../components/AppCard.astro';
import SearchFilter from '../components/SearchFilter.vue';
import { siteConfig, buildSearchItems } from '../data/site';
import { apps } from '../data/apps';
import { companies } from '../data/companies';

const featuredApps = apps.filter((app) => app.featured);
const searchItems = buildSearchItems();

const sections = [
  {
    href: '/apps',
    title: 'Aplicaciones',
    description: `${apps.length} sistemas del grupo: ERP, Microsoft 365, portales y herramientas.`,
    icon: '🗂️',
  },
  {
    href: '/recursos',
    title: 'Recursos',
    description: 'Manuales, plantillas y carpetas compartidas.',
    icon: '📚',
  },
  {
    href: '/contactos',
    title: 'Contactos',
    description: 'Directorio de personas clave por departamento.',
    icon: '👥',
  },
  {
    href: '/empresas',
    title: 'Empresas',
    description: `Las ${companies.length} empresas que forman Grupo CAP.`,
    icon: '🏢',
  },
];
---

<Layout title="CAP Suite — Portal unificado de Grupo CAP">
  <section class="relative overflow-hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-32 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-accent/10 blur-3xl"
      style="animation: hero-glow 12s ease-in-out infinite"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-24 right-0 h-72 w-72 rounded-full bg-electric/10 blur-3xl"
      style="animation: hero-glow 16s ease-in-out infinite reverse"
    >
    </div>
    <div class="relative mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent" data-reveal>Grupo Empresarial CAP</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-6xl" data-reveal style="--reveal-delay: 0.1s">
        {siteConfig.tagline}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-body" data-reveal style="--reveal-delay: 0.2s">
        {siteConfig.heroDescription}
      </p>
      <div class="mx-auto mt-8 max-w-xl text-left" data-reveal style="--reveal-delay: 0.3s">
        <SearchFilter client:load mode="global" searchItems={searchItems} />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeader
      eyebrow="Accesos rápidos"
      title="Lo que más usas"
      description="Los sistemas de uso diario, a un clic."
    />
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featuredApps.map((app, index) => <AppCard app={app} index={index} />)}
    </div>
    <div class="mt-8" data-reveal>
      <a href="/apps" class="inline-flex items-center gap-2 font-semibold text-accent transition-colors hover:text-bright">
        Ver todas las aplicaciones <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="border-t border-edge bg-surface/40">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <SectionHeader eyebrow="Explora" title="Todo el portal" />
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          sections.map((section, index) => (
            <a
              href={section.href}
              data-reveal
              style={`--reveal-delay: ${index * 0.08}s`}
              class="group rounded-xl border border-edge bg-ink p-6 transition duration-300 hover:-translate-y-1 hover:border-accent/60"
            >
              <span class="text-3xl">{section.icon}</span>
              <h3 class="mt-4 font-bold transition-colors duration-200 group-hover:text-accent">{section.title}</h3>
              <p class="mt-1 text-sm text-body">{section.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
