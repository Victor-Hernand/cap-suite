---
import AdminLayout from '../../layouts/AdminLayout.astro';
import CollectionManager from '../../components/admin/CollectionManager.vue';
import type { Column, Field } from '../../components/admin/types';
import { FIELD_MAX } from '../../lib/fieldRules';
import { getDb, listResources } from '../../lib/db';

const rows = listResources(getDb()).map((resource) => ({
  ...resource,
  source: resource.url ?? `Archivo: ${resource.filePath}`,
}));

const columns: Column[] = [
  { key: 'name', label: 'Nombre' },
  { key: 'type', label: 'Tipo', kind: 'muted' },
  { key: 'source', label: 'Origen', kind: 'muted' },
];

const fields: Field[] = [
  { name: 'name', label: 'NOMBRE', kind: 'text', required: true, maxLength: FIELD_MAX.name },
  { name: 'description', label: 'DESCRIPCIÓN', kind: 'textarea', required: true, maxLength: FIELD_MAX.description },
  {
    name: 'type',
    label: 'TIPO',
    kind: 'select',
    required: true,
    options: [
      { value: 'manual', label: 'Manual' },
      { value: 'template', label: 'Plantilla' },
      { value: 'folder', label: 'Carpeta' },
      { value: 'link', label: 'Enlace' },
    ],
  },
  {
    name: 'url',
    label: 'ENLACE',
    kind: 'url',
    placeholder: 'https://… (o sube un archivo abajo)',
    hint: 'Pega la dirección completa copiada del navegador, por ejemplo de SharePoint.',
    maxLength: FIELD_MAX.url,
  },
  { name: 'file', label: 'ARCHIVO', kind: 'file-doc' },
];
---

<AdminLayout title="Recursos" active="recursos">
  <h1 class="text-2xl font-extrabold">Recursos</h1>
  <p class="mt-1 text-sm text-body">{rows.length} documentos y enlaces</p>
  <div class="mt-5">
    <CollectionManager
      client:load
      collection="resources"
      entityName="recurso"
      entityGender="m"
      entityNamePlural="recursos"
      rows={rows}
      columns={columns}
      fields={fields}
    />
  </div>
</AdminLayout>
