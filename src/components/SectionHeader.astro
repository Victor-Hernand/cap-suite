---
interface Props {
  eyebrow: string;
  title: string;
  as?: 'h1' | 'h2';
}

const { eyebrow, title, as = 'h2' } = Astro.props as Props;
const Heading = as;
---

<div>
  <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-muted">{eyebrow}</p>
  <Heading class="mt-1.5 text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{title}</Heading>
</div>
