---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<!-- ClientRouter reemplaza los atributos de <html> al navegar: se vuelve a aplicar el tema tras cada cambio. -->
<script is:inline>
  (() => {
    const applyStoredTheme = () => {
      let storedTheme;
      try { storedTheme = localStorage.theme; } catch { storedTheme = undefined; }
      const theme = storedTheme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    };
    applyStoredTheme();
    document.addEventListener('astro:after-swap', applyStoredTheme);
  })();
</script>
<link rel="preconnect" href="https://fonts.bunny.net" />
<link href="https://fonts.bunny.net/css?family=inter:400,500,600,700|poppins:500,600,700&display=swap" rel="stylesheet" />
<title>{title}</title>
