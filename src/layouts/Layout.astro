---
import { ClientRouter } from 'astro:transitions';
import ThemeHead from '../components/shell/ThemeHead.astro';
import AppShell from '../components/shell/AppShell.astro';
import { publicNavigation } from '../data/navigation';
import '../styles/global.css';

interface Props {
  title: string;
  crumbs?: string[];
}

const { title, crumbs } = Astro.props;
---

<html lang="es">
  <head>
    <ThemeHead title={`${title} — CAP Suite`} />
    <ClientRouter />
  </head>
  <body class="bg-cap-page">
    <AppShell
      title={title}
      crumbs={crumbs}
      systemName="Portal"
      navigation={publicNavigation}
      portalLink={{ label: 'Administración', href: '/admin' }}
    >
      <slot />
    </AppShell>
  </body>
</html>
