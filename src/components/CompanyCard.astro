---
import type { CompanyRow } from '../lib/db';

interface Props {
  company: CompanyRow;
}

const { company } = Astro.props;
---

<article class="overflow-hidden rounded-xl border border-edge bg-surface shadow-[0_1px_6px_rgba(21,24,29,0.05)]">
  <div class="h-[3px]" style={`background:${company.color}`}></div>
  <div class="p-4">
    <p class="text-sm font-bold text-ink">{company.name}</p>
    <p class="mt-0.5 font-mono text-[9px] uppercase tracking-[0.16em] text-muted">{company.segment}</p>
    <p class="mt-3 text-sm italic text-body">“{company.slogan}”</p>
    <p class="mt-2 text-sm text-body">{company.description}</p>
    {company.url && (
      <a
        href={company.url}
        target="_blank"
        rel="noopener"
        class="mt-3 inline-block font-mono text-[10px] uppercase tracking-[0.16em] text-muted transition-colors hover:text-ink"
      >
        Sitio web →
      </a>
    )}
  </div>
</article>
