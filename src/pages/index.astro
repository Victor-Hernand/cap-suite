---
import Layout from '../layouts/Layout.astro';
import AppCard from '../components/AppCard.astro';
import TickRuler from '../components/TickRuler.astro';
import { getDb, listApps, counts, listRecentResources, listContacts } from '../lib/db';
import { logoSrc } from '../lib/assets';

const db = getDb();
const apps = listApps(db);
const quickAccess = [...apps.filter((app) => app.featured), ...apps.filter((app) => !app.featured)].slice(0, 8);
const totals = counts(db);
const recentResources = listRecentResources(db, 4);
const contacts = listContacts(db).slice(0, 4);

const resourceMeta: Record<string, { code: string; label: string }> = {
  manual: { code: 'MA', label: 'Manual' },
  template: { code: 'PL', label: 'Plantilla' },
  folder: { code: 'CA', label: 'Carpeta' },
  link: { code: 'EN', label: 'Enlace' },
};

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0]?.toUpperCase() ?? '')
    .join('');
}

const tegucigalpaHour = Number(
  new Intl.DateTimeFormat('es-HN', { hour: 'numeric', hour12: false, timeZone: 'America/Tegucigalpa' }).format(new Date()),
);
const greeting = tegucigalpaHour < 12 ? 'Buenos días' : tegucigalpaHour < 18 ? 'Buenas tardes' : 'Buenas noches';
const dateLabel = new Intl.DateTimeFormat('es-HN', {
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  timeZone: 'America/Tegucigalpa',
}).format(new Date());
---

<Layout title="CAP Suite — Portal unificado de Grupo CAP">
  <section class="mx-auto max-w-6xl px-4 pt-10 sm:px-6">
    <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-muted">{dateLabel} · Tegucigalpa</p>
    <h1 class="mt-1.5 text-3xl font-light tracking-tight text-ink sm:text-4xl">
      {greeting}, <span class="font-bold">Grupo CAP</span>
    </h1>
    <button
      type="button"
      class="mt-5 flex w-full max-w-xl items-center justify-between rounded-xl border border-edge bg-surface px-4 py-3 text-left text-sm text-muted shadow-sm transition-colors hover:border-edge-strong"
      onclick="window.dispatchEvent(new CustomEvent('open-command-palette'))"
    >
      Buscar sistemas, documentos, personas…
      <span class="rounded border border-edge bg-base px-1.5 py-0.5 font-mono text-[10px]">⌘K</span>
    </button>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-8 sm:px-6">
    <h2 class="font-mono text-[10px] uppercase tracking-[0.22em] text-muted">Accesos rápidos</h2>
    {quickAccess.length === 0 && (
      <p class="mt-4 rounded-xl border border-edge bg-surface px-5 py-8 text-center text-sm text-body">
        Aún no hay aplicaciones registradas. Agrégalas desde el panel de administración.
      </p>
    )}
    <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {quickAccess.map((app) => <AppCard app={app} />)}
    </div>
    <a href="/apps" class="mt-4 inline-block text-sm font-semibold text-ink hover:underline">Ver todas las aplicaciones →</a>
  </section>

  <section class="mx-auto grid max-w-6xl grid-cols-1 gap-4 px-4 pt-8 sm:grid-cols-2 sm:px-6">
    <div class="flex flex-col rounded-xl border border-edge bg-surface">
      <div class="flex items-center justify-between border-b border-edge px-4 py-3">
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted">Recursos recientes</p>
        <a href="/recursos" class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink transition-colors hover:opacity-70">Ver todos →</a>
      </div>
      {recentResources.length === 0 ? (
        <p class="px-4 py-6 text-sm text-body">Aún no hay recursos. Agrégalos desde el panel de administración.</p>
      ) : (
        <ul>
          {recentResources.map((resource) => (
            <li>
              <a
                href={resource.url ?? `/files/${resource.filePath}`}
                target="_blank"
                rel="noopener"
                class="flex items-center gap-3 border-b border-edge px-4 py-3 transition-colors last:border-b-0 hover:bg-base"
              >
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-edge bg-base font-mono text-[10px] font-semibold text-body">
                  {resourceMeta[resource.type]?.code ?? 'DOC'}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-semibold text-ink">{resource.name}</span>
                  <span class="block truncate text-xs text-muted">
                    {resourceMeta[resource.type]?.label ?? 'Documento'} · {resource.description}
                  </span>
                </span>
                <span class="shrink-0 text-muted" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="flex flex-col rounded-xl border border-edge bg-surface">
      <div class="flex items-center justify-between border-b border-edge px-4 py-3">
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted">Directorio</p>
        <a href="/contactos" class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink transition-colors hover:opacity-70">Ver todo →</a>
      </div>
      {contacts.length === 0 ? (
        <p class="px-4 py-6 text-sm text-body">Aún no hay contactos. Agrégalos desde el panel de administración.</p>
      ) : (
        <ul>
          {contacts.map((contact) => (
            <li>
              <a
                href={`mailto:${contact.email}`}
                class="flex items-center gap-3 border-b border-edge px-4 py-3 transition-colors last:border-b-0 hover:bg-base"
              >
                {logoSrc(contact.photoPath) ? (
                  <img
                    src={logoSrc(contact.photoPath)}
                    alt={`Foto de ${contact.name}`}
                    width="36"
                    height="36"
                    class="h-9 w-9 shrink-0 rounded-full border border-edge object-cover"
                  />
                ) : (
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-edge bg-base font-mono text-[10px] font-semibold text-body">
                    {initials(contact.name)}
                  </span>
                )}
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-semibold text-ink">{contact.name}</span>
                  <span class="block truncate text-xs text-muted">{contact.role} · {contact.department}</span>
                </span>
                <span class="shrink-0 font-mono text-[10px] uppercase tracking-[0.14em] text-muted" aria-hidden="true">@</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-10 pb-4 sm:px-6">
    <TickRuler counts={totals} />
  </section>
</Layout>
