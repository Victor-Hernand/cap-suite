---
import Layout from '../../layouts/Layout.astro';
import PolicyBadges from '../../components/PolicyBadges.astro';
import { getDb } from '../../lib/db';
import { getVisiblePolicyBySlug } from '../../lib/policies';
import { getDepartmentByName } from '../../lib/departments';
import { attachmentKinds, labelOf, policyClassifications } from '../../data/policies';
import { policyBadgeClass } from '../../lib/policyBadges';
import { formatDate } from '../../lib/dates';
import { cardClass, eyebrowClass } from '../../lib/publicStyles';

const SUPERVISOR = 'Mejora Continua y Automatización';
const EMBEDDABLE_IMAGE = /\.(png|jpe?g|webp)$/i;

const db = getDb();
const policy = getVisiblePolicyBySlug(db, Astro.params.slug ?? '');
if (!policy) return new Response(null, { status: 404 });

const department = getDepartmentByName(db, policy.department);
const officialHref = policy.officialFilePath ? `/files/${policy.officialFilePath}` : null;
const officialIsImage = policy.officialFilePath ? EMBEDDABLE_IMAGE.test(policy.officialFilePath) : false;

const textSections = [
  { title: 'Objetivo', text: policy.objective },
  { title: 'Ámbito de aplicación', text: policy.scope },
].filter((section) => section.text);

const sidebarFacts = [
  { label: 'Clasificación', value: labelOf(policyClassifications, policy.classification) },
  { label: 'Vigencia desde', value: formatDate(policy.effectiveDate) },
  { label: 'Próxima revisión', value: formatDate(policy.nextReviewDate) },
  { label: 'Responsable del documento', value: policy.owner },
  { label: 'Aprobador', value: policy.approver },
  { label: 'Supervisado por', value: SUPERVISOR },
  { label: 'Documentos relacionados', value: policy.relatedDocuments },
  { label: 'Indicadores asociados', value: policy.indicators },
].filter((fact) => fact.value);

const proseClass = 'mt-2 whitespace-pre-line text-sm leading-relaxed text-body';
const sideBoxClass = `${cardClass} p-4`;
---

<Layout title={`${policy.title} — CAP Suite`}>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-10 sm:px-6">
    <a href="/politicas" class="text-sm font-semibold text-body hover:text-ink">&larr; Volver al Centro de Políticas</a>

    {policy.status === 'obsolete' && (
      <p class="mt-4 rounded-xl border border-admin-gold bg-admin-gold/15 px-4 py-3 text-sm font-semibold text-ink" role="status">
        Esta política está obsoleta y ya no está vigente. Consulta la versión vigente antes de aplicarla.
      </p>
    )}

    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <article class={`${cardClass} p-5 sm:p-7`}>
        <PolicyBadges
          type={policy.type}
          status={policy.status}
          classification={policy.classification}
          version={policy.version}
          effectiveDate={policy.effectiveDate}
        />
        <h1 class="mt-3 text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{policy.title}</h1>
        <p class={`${eyebrowClass} mt-2`}>
          {policy.department}{policy.owner && ` · Responsable: ${policy.owner}`}
        </p>

        {policy.summary && (
          <p class="mt-5 rounded-lg border border-edge bg-base px-4 py-3 text-sm text-body">
            <strong class="text-ink">Resumen:</strong> {policy.summary}
          </p>
        )}

        {textSections.map((section) => (
          <div class="mt-7">
            <h2 class={eyebrowClass}>{section.title}</h2>
            <p class={proseClass}>{section.text}</p>
          </div>
        ))}

        {policy.guidelines.length > 0 && (
          <div class="mt-7">
            <h2 class={eyebrowClass}>Lineamientos</h2>
            <ol class="mt-3 space-y-3">
              {policy.guidelines.map((guideline, index) => (
                <li class="rounded-lg border border-edge px-4 py-3">
                  <h3 class="text-sm font-bold text-ink">{index + 1}. {guideline.title}</h3>
                  <p class={proseClass}>{guideline.body}</p>
                </li>
              ))}
            </ol>
          </div>
        )}

        {policy.attachments.length > 0 && (
          <div class="mt-7">
            <h2 class={eyebrowClass}>Anexos</h2>
            <ul class="mt-3 space-y-2">
              {policy.attachments.map((attachment) => {
                const isFile = attachment.kind === 'file';
                const href = isFile ? `/files/${attachment.filePath}` : attachment.url;
                return (
                  <li>
                    <a
                      href={href}
                      target={isFile ? undefined : '_blank'}
                      rel={isFile ? undefined : 'noopener'}
                      class="flex items-center gap-3 rounded-lg border border-edge px-3 py-2 text-sm text-ink hover:bg-base"
                    >
                      <span class={policyBadgeClass(attachment.kind)}>{labelOf(attachmentKinds, attachment.kind)}</span>
                      {attachment.label}
                      {!isFile && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        )}

        {officialHref && officialIsImage && (
          <img src={officialHref} alt={`Documento oficial: ${policy.title}`} class="mt-7 w-full rounded-lg border border-edge" />
        )}

        {officialHref && (
          <a
            href={officialHref}
            download
            class="mt-7 inline-block rounded-lg bg-ink px-4 py-2 text-sm font-bold text-white"
          >
            Descargar oficial
          </a>
        )}
      </article>

      <aside class="space-y-3 self-start">
        <div class={sideBoxClass}>
          <p class={eyebrowClass}>Departamento</p>
          <p class="mt-1 text-sm font-bold text-ink">
            {department
              ? <a href={`/departamentos/${department.slug}`} class="underline decoration-edge-strong underline-offset-2 hover:decoration-ink">{policy.department}</a>
              : policy.department}
          </p>
        </div>

        {sidebarFacts.map((fact) => (
          <div class={sideBoxClass}>
            <p class={eyebrowClass}>{fact.label}</p>
            <p class="mt-1 whitespace-pre-line text-sm text-ink">{fact.value}</p>
          </div>
        ))}

        {policy.versions.length > 0 && (
          <div class={sideBoxClass}>
            <p class={eyebrowClass}>Control de cambios</p>
            <ul class="mt-2 space-y-2">
              {policy.versions.map((entry) => (
                <li class="text-sm text-ink">
                  <span class="font-bold">{entry.version}</span>
                  <span class="text-body"> · {formatDate(entry.date)} — {entry.author}</span>
                  <span class="block text-xs text-muted">{entry.reason}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>
</Layout>
