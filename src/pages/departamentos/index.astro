---
import Layout from '../../layouts/Layout.astro';
import { getDb } from '../../lib/db';
import { countVisiblePoliciesByDepartment } from '../../lib/policies';
import { listDepartments } from '../../lib/departments';
import { policyCountLabel } from '../../data/policies';
import { emptyStateClass } from '../../lib/capClasses';

const db = getDb();
const departments = listDepartments(db);
const policyCounts = countVisiblePoliciesByDepartment(db);

function departmentPolicyCountLabel(departmentName: string): string {
  const total = policyCounts.get(departmentName) ?? 0;
  return total === 0 ? 'Sin políticas aún' : policyCountLabel(total);
}
---

<Layout title="Departamentos">
  <p class="max-w-3xl text-sm text-cap-text-soft">
    Cada departamento reúne sus políticas, procesos, formatos, equipo, enlaces y avisos en un solo lugar.
  </p>

  {departments.length === 0 ? (
    <div class={emptyStateClass}>
      <i class="mdi mdi-office-building-outline text-cap-icon text-gray-400" aria-hidden="true"></i>
      <p class="mt-3 font-display text-base font-semibold text-gray-900 dark:text-gray-100">Aún no hay departamentos</p>
      <p class="mt-1 text-sm text-cap-text-soft">Se agregan desde el panel de administración.</p>
    </div>
  ) : (
    <div class="cap-stagger grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {departments.map((department) => (
        <a
          href={`/departamentos/${department.slug}`}
          class="flex items-center gap-3 rounded-cap-card border border-cap-divider bg-cap-card p-5 transition-colors duration-cap-fast ease-cap hover:bg-cap-card-2"
        >
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-cap-control bg-cap-red-200 text-cap-red-800 dark:bg-cap-red-600/20 dark:text-cap-brand-soft" aria-hidden="true">
            <i class="mdi mdi-office-building-outline text-xl leading-none"></i>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-semibold text-gray-900 dark:text-gray-100">{department.name}</span>
            <span class="block text-xs text-cap-text-soft tabular-nums">{departmentPolicyCountLabel(department.name)}</span>
          </span>
          <i class="mdi mdi-chevron-right text-xl leading-none text-cap-text-soft" aria-hidden="true"></i>
        </a>
      ))}
    </div>
  )}
</Layout>
