---
import { ClientRouter } from 'astro:transitions';
import ThemeHead from '../components/shell/ThemeHead.astro';
import AppShell from '../components/shell/AppShell.astro';
import { publicNavigation } from '../data/navigation';
import '../styles/global.css';

interface Props {
  title: string;
  crumbs?: string[];
}

const PRODUCT_NAME = 'CAP Suite';

const { title, crumbs } = Astro.props;
// Las páginas pasan el título del documento («Aplicaciones — CAP Suite»); el header muestra solo el de la página.
const pageTitle = title
  .split(' — ')
  .filter((part) => part !== PRODUCT_NAME)
  .join(' — ');
---

<html lang="es">
  <head>
    <ThemeHead title={title} />
    <ClientRouter />
  </head>
  <body class="bg-cap-page">
    <AppShell
      title={pageTitle}
      crumbs={crumbs}
      systemName="Portal"
      navigation={publicNavigation}
      portalLink={{ label: 'Administración', href: '/admin' }}
    >
      <slot />
    </AppShell>
  </body>
</html>
