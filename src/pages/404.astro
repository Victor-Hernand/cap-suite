---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <div class="flex min-h-[60vh] items-center justify-center p-6">
    <div class="max-w-md text-center">
      <i class="mdi mdi-compass-off-outline text-cap-icon text-gray-400" aria-hidden="true"></i>
      <h2 class="mt-3 font-display text-2xl font-semibold text-gray-900 dark:text-gray-100">No encontramos esta página</h2>
      <p class="mt-1 text-sm text-cap-text-soft">Puede que la dirección haya cambiado o que el contenido ya no esté publicado.</p>
      <div class="mt-4"><a href="/" class="cap-button cap-button--primary">Volver al inicio</a></div>
    </div>
  </div>
</Layout>
