---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SearchFilter from '../components/SearchFilter.vue';
import { apps, appCategories } from '../data/apps';
---

<Layout title="Aplicaciones — CAP Suite">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <SectionHeader
      as="h1"
      eyebrow="Aplicaciones"
      title="Todos los sistemas del grupo"
      description="Busca por nombre o filtra por categoría. Cada tarjeta abre el sistema en una pestaña nueva."
    />
    <div class="mt-8">
      <SearchFilter client:load mode="catalog" apps={apps} categories={appCategories} />
    </div>
  </section>
</Layout>
