---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  as?: 'h1' | 'h2';
}

const { eyebrow, title, description, as = 'h2' } = Astro.props;
const Heading = as;
---

<div class="max-w-2xl" data-reveal>
  <p class="font-mono text-xs uppercase tracking-widest text-accent">{eyebrow}</p>
  <Heading class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{title}</Heading>
  {description && <p class="mt-3 text-body">{description}</p>}
</div>
