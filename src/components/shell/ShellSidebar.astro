---
import { company } from '../../design/company.js';
import { isActiveHref } from '../../data/navigation';
import type { NavGroup, PortalLink, ShellUser as ShellUserData } from '../../data/navigation';
import ShellSidebarItem from './ShellSidebarItem.astro';
import ShellUser from './ShellUser.astro';

interface Props {
  systemName: string;
  navigation: NavGroup[];
  user?: ShellUserData | null;
  portalLink?: PortalLink | null;
}

const { systemName, navigation, user = null, portalLink = null } = Astro.props;
const pathname = Astro.url.pathname;
---

<aside class="cap-shell-sidebar cap-glass" data-cap-sidebar data-collapsed="false">
  {/* Misma clave y defectos que collapse.js: aplica el riel antes de pintar para que no parpadee. */}
  <script is:inline>
    (() => {
      const sidebar = document.querySelector('[data-cap-sidebar]');
      let stored = null;
      try { stored = localStorage.getItem('cap-shell:sidebar-collapsed'); } catch { stored = null; }
      const collapsed = stored === null ? innerWidth >= 1024 : stored === 'true';
      sidebar.style.transition = 'none';
      sidebar.dataset.collapsed = String(collapsed);
      void sidebar.offsetWidth;
      sidebar.style.transition = '';
    })();
  </script>
  <button class="cap-shell-sidebar__collapse" type="button" data-cap-collapse aria-expanded="true" aria-label="Contraer menú">
    <i class="mdi mdi-chevron-left" aria-hidden="true"></i>
  </button>

  <div class="cap-shell-sidebar__brand">
    <span class="cap-shell-logo" aria-hidden="true">{company.mark}</span>
    <div class="cap-shell-sidebar__brand-text">
      <strong class="cap-shell-sidebar__brand-name">{systemName}</strong>
      <small class="cap-shell-sidebar__brand-owner">{company.name}</small>
    </div>
  </div>

  <nav class="cap-shell-sidebar__nav" aria-label="Menú principal">
    {navigation.map((group) => (
      <Fragment>
        <p class="cap-shell-sidebar__group-label">{group.label}</p>
        {group.items.map((item) => <ShellSidebarItem item={item} active={isActiveHref(pathname, item.href)} />)}
      </Fragment>
    ))}
  </nav>

  <div class="cap-shell-sidebar__spacer"></div>

  {portalLink && <ShellSidebarItem item={{ ...portalLink, icon: 'swap-horizontal' }} active={false} />}

  <button class="cap-shell-sidebar__item cap-shell-sidebar__theme" type="button" data-cap-theme-toggle aria-label="Alternar modo oscuro">
    <i class="cap-shell-sidebar__icon mdi mdi-weather-night" aria-hidden="true"></i>
    <span class="cap-shell-sidebar__label">Modo oscuro</span>
    <span class="cap-shell-sidebar__switch" aria-hidden="true"></span>
    <span class="cap-shell-sidebar__tooltip" aria-hidden="true">Modo oscuro</span>
  </button>

  {user && <ShellUser user={user} />}
</aside>
