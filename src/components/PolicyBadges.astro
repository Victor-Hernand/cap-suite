---
import {
  labelOf,
  policyClassifications,
  policyStatuses,
  policyTypes,
  type PolicyClassification,
  type PolicyStatus,
  type PolicyType,
} from '../data/policies';
import { policyBadgeClass } from '../lib/policyBadges';
import { statusDotClass } from '../lib/capClasses';
import { formatVersionLine } from '../lib/dates';

interface Props {
  type: PolicyType;
  status: PolicyStatus;
  classification: PolicyClassification;
  version?: string | null;
  effectiveDate?: string | null;
}

const { type, status, classification, version = null, effectiveDate = null } = Astro.props;
const versionLine = formatVersionLine(version, effectiveDate);
---

<div class="flex flex-wrap items-center gap-1.5">
  <span class={policyBadgeClass(type)}>{labelOf(policyTypes, type)}</span>
  <span class={policyBadgeClass(status)}><span class={statusDotClass}></span>{labelOf(policyStatuses, status)}</span>
  <span class={policyBadgeClass(classification)}>{labelOf(policyClassifications, classification)}</span>
  {versionLine && <span class="text-xs text-cap-text-soft tabular-nums">{versionLine}</span>}
</div>
