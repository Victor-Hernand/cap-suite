---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CollectionManager from '../../../components/admin/CollectionManager.vue';
import type { Column, Field } from '../../../components/admin/types';
import { FIELD_MAX } from '../../../lib/fieldRules';
import { getDb } from '../../../lib/db';
import { listDepartments } from '../../../lib/departments';
import { NO_DEPARTMENT_CONTENT, countDepartmentContentByDepartment } from '../../../lib/departmentContent';

const db = getDb();
const contentByDepartment = countDepartmentContentByDepartment(db);
const rows = listDepartments(db).map((department) => {
  const content = contentByDepartment.get(department.name) ?? NO_DEPARTMENT_CONTENT;
  return {
    ...department,
    href: `/admin/departamentos/${department.slug}`,
    publicPath: `/departamentos/${department.slug}`,
    contentSummary: `${content.processes} procesos · ${content.formats} formatos · ${content.links} enlaces · ${content.notices} avisos`,
  };
});

const columns: Column[] = [
  { key: 'name', label: 'Nombre', kind: 'link', hrefKey: 'href' },
  { key: 'contentSummary', label: 'Contenido', kind: 'muted' },
  { key: 'publicPath', label: 'Dirección pública', kind: 'muted' },
];

const fields: Field[] = [
  {
    name: 'name',
    label: 'NOMBRE',
    kind: 'text',
    required: true,
    maxLength: FIELD_MAX.name,
    hint: 'Al renombrar, contactos, políticas y contenido pasan al nombre nuevo. La dirección pública no cambia.',
  },
];
---

<AdminLayout title="Departamentos">
  <h1 class="text-2xl font-extrabold">Departamentos</h1>
  <p class="mt-1 text-sm text-body">
    {rows.length} departamentos. Elige uno para administrar sus procesos, formatos, enlaces y avisos. Solo se puede
    eliminar un departamento sin contactos, políticas ni contenido.
  </p>
  <div class="mt-5">
    <CollectionManager
      client:load
      collection="departments"
      entityName="departamento"
      entityGender="m"
      entityNamePlural="departamentos"
      rows={rows}
      columns={columns}
      fields={fields}
    />
  </div>
</AdminLayout>
