---
import AdminLayout from '../../layouts/AdminLayout.astro';
import CollectionManager from '../../components/admin/CollectionManager.vue';
import type { Column, Field } from '../../components/admin/types';
import { FIELD_MAX } from '../../lib/fieldRules';
import { getDb, listCompanies } from '../../lib/db';

const rows = listCompanies(getDb()).map((company) => ({
  ...company,
  ledColor: company.color,
  companyLabel: company.segment,
  logoUrl: company.logoPath?.startsWith('http') ? company.logoPath : '',
}));

const columns: Column[] = [
  { key: 'name', label: 'Nombre' },
  { key: 'companyLabel', label: 'Segmento', kind: 'led' },
  { key: 'slogan', label: 'Slogan', kind: 'muted' },
];

const fields: Field[] = [
  { name: 'name', label: 'NOMBRE', kind: 'text', required: true, maxLength: FIELD_MAX.name },
  { name: 'segment', label: 'SEGMENTO', kind: 'text', required: true, maxLength: FIELD_MAX.shortText },
  { name: 'description', label: 'DESCRIPCIÓN', kind: 'textarea', required: true, maxLength: FIELD_MAX.description },
  { name: 'slogan', label: 'SLOGAN', kind: 'text', required: true, maxLength: FIELD_MAX.slogan },
  { name: 'color', label: 'COLOR (HEX)', kind: 'text', required: true, placeholder: '#C62828', maxLength: FIELD_MAX.color },
  { name: 'url', label: 'SITIO WEB', kind: 'url', placeholder: 'https://… (opcional)', maxLength: FIELD_MAX.url },
  { name: 'logo', label: 'LOGO', kind: 'file-logo' },
  { name: 'logoUrl', label: 'O URL DE LOGO EXTERNO', kind: 'url', placeholder: 'https://… (opcional)', maxLength: FIELD_MAX.url },
];
---

<AdminLayout title="Empresas" active="empresas">
  <h1 class="text-2xl font-extrabold">Empresas</h1>
  <p class="mt-1 text-sm text-body">{rows.length} empresas del grupo</p>
  <div class="mt-5">
    <CollectionManager
      client:load
      collection="companies"
      entityName="empresa"
      entityGender="f"
      entityNamePlural="empresas"
      rows={rows}
      columns={columns}
      fields={fields}
    />
  </div>
</AdminLayout>
