---
import type { ResourceRow } from '../lib/db';
import { resourceTypes } from '../data/categories';

interface Props {
  resource: ResourceRow;
}

const { resource } = Astro.props;
const badge = resourceTypes.find((type) => type.id === resource.type)?.badge ?? resource.type.toUpperCase();
const href = resource.url ?? `/files/${resource.filePath}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="group flex flex-col rounded-xl border border-edge bg-surface p-4 shadow-[0_1px_6px_rgba(21,24,29,0.05)] transition-all hover:-translate-y-0.5 hover:shadow-md"
>
  <span class="self-start rounded border border-edge px-1.5 py-0.5 font-mono text-[9px] tracking-[0.18em] text-muted">
    {badge}
  </span>
  <p class="mt-3 text-sm font-bold text-ink">
    {resource.name}<span class="sr-only"> (se abre en una pestaña nueva)</span>
  </p>
  <p class="mt-1 text-sm text-body">{resource.description}</p>
</a>
