---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl" data-reveal>
  <p class="text-sm font-semibold uppercase tracking-widest text-accent">{eyebrow}</p>
  <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {description && <p class="mt-3 text-body">{description}</p>}
</div>
