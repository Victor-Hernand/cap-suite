---
import type { Company } from '../data/types';

interface Props {
  company: Company;
  index: number;
}

const { company, index }: Props = Astro.props;

const brandText = `color-mix(in oklab, ${company.color} 55%, var(--color-bright))`;
const brandTile = `color-mix(in oklab, ${company.color} 15%, white)`;
---

<article
  data-reveal
  style={`--reveal-delay: ${Math.min(index, 6) * 0.04}s`}
  class="relative overflow-hidden rounded-2xl border border-edge bg-surface p-5 transition-colors duration-300 hover:border-edge-strong"
>
  <span class="absolute inset-x-0 top-0 h-1" style={`background-color: ${company.color}`}></span>
  <div class="flex items-center gap-3">
    <span
      aria-hidden="true"
      class="flex h-11 w-11 items-center justify-center rounded-lg text-lg font-black"
      style={`background: ${brandTile}; color: ${brandText}`}
    >
      {company.name.charAt(0)}
    </span>
    <div>
      <h3 class="font-bold">{company.name}</h3>
      <p class="text-xs uppercase tracking-wide text-body">{company.segment}</p>
    </div>
  </div>
  <p class="mt-4 text-sm text-body">{company.description}</p>
  <p class="mt-4 text-sm font-medium italic" style={`color: ${brandText}`}>“{company.slogan}”</p>
</article>
