---
import AppCardContent from './AppCardContent.vue';
import type { AppLink } from '../data/types';

interface Props {
  app: AppLink;
  index?: number;
}

const { app, index = 0 }: Props = Astro.props;
---

<div class="h-full" data-reveal style={`--reveal-delay: ${Math.min(index, 6) * 0.04}s`}>
  <AppCardContent app={app} />
</div>
