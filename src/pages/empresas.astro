---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CompanyCard from '../components/CompanyCard.astro';
import { getDb, listCompanies } from '../lib/db';
import { companiesIntro } from '../data/companies';

const db = getDb();
const companies = listCompanies(db).map((company) => ({
  id: company.slug,
  name: company.name,
  segment: company.segment,
  description: company.description,
  slogan: company.slogan,
  color: company.color,
  url: company.url ?? undefined,
}));
---

<Layout title="Empresas — CAP Suite">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeader as="h1" eyebrow="Grupo Empresarial CAP" title={companiesIntro.title} description={companiesIntro.description} />
    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {companies.map((company, index) => <CompanyCard company={company} index={index} />)}
    </div>
  </section>
</Layout>
