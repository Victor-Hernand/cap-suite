---
import Layout from '../layouts/Layout.astro';
import ContactAvatar from '../components/ContactAvatar.astro';
import ContactCard from '../components/ContactCard.astro';
import { getDb, listContacts } from '../lib/db';
import { findDepartmentByName } from '../data/departments';
import { listDepartments } from '../lib/departments';
import { contactPhoneHref, contactPhoneLabel } from '../lib/contacts';
import { emptyStateClass, tableCellClass, tableClass, tableHeadClass } from '../lib/capClasses';

const db = getDb();
const catalog = listDepartments(db);
const contacts = listContacts(db).map((contact) => ({
  ...contact,
  departmentSlug: findDepartmentByName(catalog, contact.department)?.slug ?? null,
}));

const columns = ['Nombre', 'Cargo', 'Departamento', 'Empresa', 'Teléfono'];
const stickyHeadClass = `${tableHeadClass} lg:sticky lg:top-cap-below-header z-cap-header`;

function headCornerClass(index: number): string {
  if (index === 0) return 'rounded-tl-cap-card';
  return index === columns.length - 1 ? 'rounded-tr-cap-card' : '';
}
---

<Layout title="Contactos">
  {contacts.length === 0 ? (
    <div class={emptyStateClass}>
      <i class="mdi mdi-account-box-outline text-cap-icon text-gray-400" aria-hidden="true"></i>
      <p class="mt-3 font-display text-base font-semibold text-gray-900 dark:text-gray-100">Aún no hay contactos en el directorio</p>
      <p class="mt-1 text-sm text-cap-text-soft">Se agregan desde el panel de administración.</p>
    </div>
  ) : (
    <>
      <p class="text-sm text-cap-text-soft tabular-nums">
        {contacts.length} {contacts.length === 1 ? 'persona' : 'personas'} en el directorio
      </p>

      <div class="hidden isolate rounded-cap-card border border-cap-divider bg-cap-card lg:block">
        <table class={tableClass}>
          <thead>
            <tr>
              {columns.map((column, index) => (
                <th scope="col" class={`${headCornerClass(index)} ${stickyHeadClass}`}>{column}</th>
              ))}
            </tr>
          </thead>
          <tbody class="cap-stagger-rows [&>tr:last-child>td:first-child]:rounded-bl-cap-card [&>tr:last-child>td:last-child]:rounded-br-cap-card">
            {contacts.map((contact) => (
              <tr class="transition-colors duration-cap-fast ease-cap hover:bg-cap-card-2">
                <td class={`${tableCellClass} py-2`}>
                  <div class="flex items-center gap-3">
                    <ContactAvatar name={contact.name} photoPath={contact.photoPath} />
                    <div class="min-w-0">
                      <a href={`mailto:${contact.email}`} class="font-medium text-cap-brand hover:underline dark:text-cap-brand-soft">{contact.name}</a>
                      <p class="truncate text-xs text-cap-text-soft">{contact.email}</p>
                    </div>
                  </div>
                </td>
                <td class={tableCellClass}>{contact.role}</td>
                <td class={tableCellClass}>
                  {contact.departmentSlug
                    ? <a href={`/departamentos/${contact.departmentSlug}`} class="underline decoration-gray-400 underline-offset-2 hover:decoration-current">{contact.department}</a>
                    : contact.department}
                </td>
                <td class={tableCellClass}>{contact.company}</td>
                <td class={`${tableCellClass} whitespace-nowrap tabular-nums`}>
                  <a href={contactPhoneHref(contact)} class="hover:underline">{contactPhoneLabel(contact)}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="flex flex-col gap-3 lg:hidden">
        {contacts.map((contact) => (
          <ContactCard contact={contact} departmentHref={contact.departmentSlug ? `/departamentos/${contact.departmentSlug}` : null} />
        ))}
      </div>
    </>
  )}
</Layout>
