---
import type { ContactRow } from '../lib/db';
import { logoSrc } from '../lib/assets';

interface Props {
  contact: ContactRow;
}

const { contact } = Astro.props;
const photo = logoSrc(contact.photoPath);
const initials = contact.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0]?.toUpperCase() ?? '')
  .join('');
const phoneDigits = contact.phone.replace(/\D/g, '');
const phoneLabel = contact.extension ? `${contact.phone} · ext. ${contact.extension}` : contact.phone;
---

<article class="rounded-xl border border-edge bg-surface p-4 shadow-[0_1px_6px_rgba(21,24,29,0.05)]">
  <div class="flex items-start gap-3">
    {photo ? (
      <img
        src={photo}
        alt={`Foto de ${contact.name}`}
        width="44"
        height="44"
        class="h-11 w-11 shrink-0 rounded-full border border-edge object-cover"
      />
    ) : (
      <span
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-edge bg-base font-mono text-xs font-semibold text-body"
        aria-hidden="true"
      >
        {initials}
      </span>
    )}
    <div class="min-w-0 flex-1">
      <p class="text-sm font-bold text-ink">{contact.name}</p>
      <p class="mt-0.5 text-sm text-muted">{contact.role} · {contact.department}</p>
      <p class="mt-0.5 font-mono text-[9px] uppercase tracking-[0.16em] text-muted">{contact.company}</p>
    </div>
  </div>
  <div class="mt-3 grid gap-1 font-mono text-xs">
    <a href={`tel:+${phoneDigits}`} class="text-body transition-colors hover:text-ink">{phoneLabel}</a>
    <a href={`mailto:${contact.email}`} class="truncate text-body transition-colors hover:text-ink">{contact.email}</a>
  </div>
</article>
