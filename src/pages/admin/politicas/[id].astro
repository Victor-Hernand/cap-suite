---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PolicyEditor from '../../../components/admin/PolicyEditor.vue';
import { labelOf, policyStatuses } from '../../../data/policies';
import { policyBadgeClass } from '../../../lib/policyBadges';
import { getDb } from '../../../lib/db';
import { getPolicy } from '../../../lib/policies';
import { listDepartments } from '../../../lib/departments';

const db = getDb();
const policy = getPolicy(db, Number(Astro.params.id));
if (!policy) return Astro.redirect('/admin/politicas');

const isDraft = policy.status === 'draft';
const departments = listDepartments(db);
---

<AdminLayout title={policy.title}>
  <a href="/admin/politicas" class="text-xs font-semibold text-muted hover:text-ink">← Todas las políticas</a>
  <div class="mt-2 flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-extrabold">{policy.title}</h1>
    <span class={policyBadgeClass(policy.status)}><span class="h-1.5 w-1.5 rounded-full bg-current"></span>{labelOf(policyStatuses, policy.status)}</span>
  </div>
  <p class="mt-1 text-sm text-body">
    {isDraft
      ? 'Borrador: no aparece en el portal hasta publicar una versión.'
      : <>Visible en el portal: <a href={`/politicas/${policy.slug}`} class="font-semibold text-ink hover:underline">ver ficha pública ↗</a></>}
  </p>
  <div class="mt-5">
    <PolicyEditor client:load policy={policy} departments={departments} />
  </div>
</AdminLayout>
