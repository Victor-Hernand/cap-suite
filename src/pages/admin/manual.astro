---
import AdminLayout from '../../layouts/AdminLayout.astro';
import CollectionManager from '../../components/admin/CollectionManager.vue';
import type { Column, Field } from '../../components/admin/types';
import { FIELD_MAX } from '../../lib/fieldRules';
import { getDb, listManuals } from '../../lib/db';
import { statusBadgeClass } from '../../design/statuses.js';
import { brandTileClass } from '../../lib/capClasses';

const manuals = listManuals(getDb()).map((manual) => ({
  ...manual,
  contentLabels: [manual.videoUrl && 'Video', manual.pdfPath && 'PDF'].filter((label) => !!label),
}));

const rows = manuals.map((manual) => ({ ...manual, content: manual.contentLabels.join(' + ') }));

const columns: Column[] = [
  { key: 'title', label: 'Título' },
  { key: 'content', label: 'Contenido', kind: 'muted' },
];

const fields: Field[] = [
  { name: 'title', label: 'Título', kind: 'text', required: true, maxLength: FIELD_MAX.name },
  { name: 'description', label: 'Descripción', kind: 'textarea', maxLength: FIELD_MAX.description },
  {
    name: 'videoUrl',
    label: 'Video de Loom',
    kind: 'url',
    placeholder: 'https://www.loom.com/share/…',
    hint: 'En Loom usa «Share» → «Copy link» y pégalo aquí. Déjalo vacío para quitar el video.',
    maxLength: FIELD_MAX.url,
  },
  {
    name: 'pdf',
    label: 'Manual en PDF',
    kind: 'file-manual',
    hint: 'Al editar, si no subes uno nuevo se conserva el PDF actual.',
  },
];

---

<AdminLayout title="Manuales">
  <p class="text-sm text-cap-text-soft">Videos y documentos para aprender a usar el panel de administración.</p>

  {manuals.length > 0 && (
    <div class="cap-stagger grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {manuals.map((manual) => (
        <a
          href={`/admin/manual/${manual.id}`}
          class="flex flex-col rounded-cap-card border border-cap-divider bg-cap-card p-5 transition-transform duration-cap-fast ease-cap hover:-translate-y-0.5"
        >
          <span class="flex items-start gap-3">
            <span class={brandTileClass} aria-hidden="true">
              <i class="mdi mdi-book-open-outline text-xl leading-none"></i>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-semibold text-gray-900 dark:text-gray-100">{manual.title}</span>
              {manual.description && <span class="mt-1 line-clamp-2 block text-xs text-cap-text-soft">{manual.description}</span>}
            </span>
          </span>
          <span class="mt-4 flex gap-2">
            {manual.contentLabels.map((label) => <span class={statusBadgeClass('neutral')}>{label}</span>)}
          </span>
        </a>
      ))}
    </div>
  )}

  <CollectionManager
    client:load
    collection="manuals"
    entityName="manual"
    entityGender="m"
    entityNamePlural="manuales"
    title="Administrar manuales"
    rows={rows}
    columns={columns}
    fields={fields}
  />
</AdminLayout>
